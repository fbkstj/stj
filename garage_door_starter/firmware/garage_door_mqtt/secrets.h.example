// secrets.h.example — 複製成 secrets.h 再填入自己的設定，不要把填好的檔案公開。
// 注意：這個檔案含有 WiFi 與 MQTT 密碼，分享資料夾或截圖時請避開。
#pragma once

// ---------- WiFi ----------
// 依序嘗試，連上哪一個就用哪一個；斷線後也是照這個順序重找。
struct WifiAp { const char *ssid; const char *pass; };
static const WifiAp WIFI_APS[] = {
  { "你的WiFi名稱",   "你的WiFi密碼" },   // 第一順位
  { "備用WiFi名稱", "備用WiFi密碼" },   // 第二順位（沒有就整行刪掉）
};
static const int WIFI_AP_COUNT = sizeof(WIFI_APS) / sizeof(WIFI_APS[0]);

// ---------- MQTT Broker ----------
#define MQTT_HOST      "你的broker網址"
#define MQTT_PORT      8883            // 8883 = TLS 加密；若改用未加密請設 1883 並見 .ino 說明
#define MQTT_USER      "你的MQTT帳號"
#define MQTT_PASS      "你的MQTT密碼"

// ---------- Topic ----------
// 三個動作各用一個 topic，收到任何訊息就觸發該動作（訊息內容不拘，空訊息也算）。
#define TOPIC_OPEN     "自己取一段別人猜不到的前綴/open"            // 收：開門
#define TOPIC_CLOSE    "自己取一段別人猜不到的前綴/close"           // 收：關門
#define TOPIC_PAUSE    "自己取一段別人猜不到的前綴/pause"           // 收：停止
#define TOPIC_STATE    "自己取一段別人猜不到的前綴/state"           // 送：open / closed
#define TOPIC_AVAIL    "自己取一段別人猜不到的前綴/avail"           // 送：online / offline
#define TOPIC_LOG      "自己取一段別人猜不到的前綴/log"             // 送：動作紀錄（可不訂閱）

