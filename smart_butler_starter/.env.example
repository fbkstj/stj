# 複製這個檔案並改名成 .env，再把值填在等號後面（不要加引號、不要有空白）
# .env 不可以上傳、不可以貼到對話框或截圖；外洩就到 Discord 刪除並重新產生

# 測試通報頻道的 Webhook（Discord 頻道設定 → 整合 → Webhook）
DISCORD_WEBHOOK_TEST=

# 留言板頻道的 Webhook（網頁留言送到 Discord 用）
DISCORD_WEBHOOK_BOARD=

# Discord Bot Token（讀取留言板頻道的留言才需要）
DISCORD_BOT_TOKEN=

# AI 閒聊用的 Claude API 金鑰（沒有也能控制家電）
AI_API_KEY=
