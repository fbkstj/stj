    "powerpoint": {
      "name": "PowerPoint 簡報",
      "window": [
        "PowerPoint"
      ],
      "keys": {
        "next_page": [
          "right"
        ],
        "prev_page": [
          "left"
        ],
        "first_page": [
          "home"
        ],
        "last_page": [
          "end"
        ],
        "black_screen": [
          "b"
        ],
        "white_screen": [
          "w"
        ],
        "start_show": [
          "f5"
        ],
        "start_here": [
          "shift",
          "f5"
        ],
        "end_show": [
          "esc"
        ],
        "laser": [
          "ctrl",
          "l"
        ],
        "pen": [
          "ctrl",
          "p"
        ],
        "arrow_pointer": [
          "ctrl",
          "a"
        ],
        "erase_ink": [
          "e"
        ]
      },
      "goto": "powerpoint",
      "gestures": {
        "point_right": {
          "action": "next_page",
          "hold_sec": 0.35,
          "repeat_sec": 1.2
        },
        "point_left": {
          "action": "prev_page",
          "hold_sec": 0.35,
          "repeat_sec": 1.2
        },
        "open_palm": {
          "action": "black_screen",
          "hold_sec": 0.8
        },
        "v_sign": {
          "action": "laser",
          "hold_sec": 0.8
        },
        "thumb_up": {
          "action": "volume_up",
          "hold_sec": 0.3,
          "repeat_sec": 0.25,
          "arg": 1
        },
        "thumb_down": {
          "action": "volume_down",
          "hold_sec": 0.3,
          "repeat_sec": 0.25,
          "arg": 1
        }
      }
    },
    "teams": {
