{
  "model_path": "models/hand_landmarker.task",
  "camera": 0,
  "camera_width": 640,
  "camera_height": 480,
  "mirror": true,
  "min_detection_confidence": 0.6,
  "min_tracking_confidence": 0.5,
  "min_palm_ratio": 0.1,
  "straight_deg": 40,
  "thumb_straight_deg": 35,
  "thumb_out_ratio": 0.5,
